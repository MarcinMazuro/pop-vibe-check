{
  // Build with latexmk and the .latexmkrc next to main.tex (thesis/ or
  // playground/). Forced, so a "% !TeX program" comment can never bypass it.
  "latex-workshop.latex.recipes": [
    { "name": "latexmk", "tools": ["latexmk"] }
  ],
  "latex-workshop.latex.tools": [
    { "name": "latexmk", "command": "latexmk", "args": ["%DOC%"], "env": {} }
  ],
  "latex-workshop.latex.build.forceRecipeUsage": true,
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.message.warning.show": false,
  "latex-workshop.linting.chktex.enabled": false,

  // Live preview: files save themselves after a 1.5 s pause, which rebuilds
  // the PDF. Formatting only runs on an explicit Ctrl+S, so text never jumps
  // while you type.
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1500,

  // Formatting (Ctrl+S): latexindent with the shared rules.
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.formatting.latexindent.args": [
    "-c", "%WORKSPACE_FOLDER%/.cache/latexindent/",
    "%TMPFILE%",
    "-l=%WORKSPACE_FOLDER%/config/latexindent.yaml",
    "-m",
    "-y=defaultIndent: '%INDENT%'"
  ],
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.wordWrap": "on"
  },
  "files.encoding": "utf8",
  "files.eol": "\n",

  // Polish grammar and spelling (LanguageTool, offline). Words added to the
  // dictionary are stored in .vscode/ and shared through git.
  "ltex.language": "pl-PL",
  "ltex.additionalRules.motherTongue": "pl-PL",
  "ltex.additionalRules.enablePickyRules": true,
  "ltex.checkFrequency": "save",
  "ltex.configurationTarget": {
    "dictionary": "workspaceFolderExternalFile",
    "disabledRules": "workspaceFolderExternalFile",
    "hiddenFalsePositives": "workspaceFolderExternalFile"
  },
  "ltex.latex.commands": {
    "\\code{}": "dummy",
    "\\marcin{}": "ignore",
    "\\oskar{}": "ignore",
    "\\kacper{}": "ignore",
    "\\supervisor{}": "ignore",
    "\\todo{}": "ignore",
    "\\lstinputlisting[]{}": "ignore",
    "\\DeclareAcronym{}{}": "ignore"
  },

  // Hide build output and the formatter's scratch files.
  "files.exclude": {
    "**/build": true,
    ".cache": true
  },
  "search.exclude": {
    "**/build": true
  }
}
