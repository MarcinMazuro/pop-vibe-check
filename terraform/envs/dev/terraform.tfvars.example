project_id = "your-gcp-project-id"

# Optional override; default is europe-central2.
# region = "europe-central2"

# Short prefix for release-specific resource names. Default "co" is
# Clair Obscur: Expedition 33. Switch (and use a separate Terraform
# workspace / state) when analysing another release, e.g. "w4".
# name_prefix = "co"

# Required by the budgets module. MUST be the billing account the GCP
# project is linked to (`gcloud billing projects describe <project_id>`),
# not merely an account you can list — otherwise the budget sees $0
# spend and alerts never fire. Same value is passed to terraform/bootstrap
# so the runner SA gets roles/billing.costsManager on that account.
billing_account_id = "XXXXXX-YYYYYY-ZZZZZZ"

# Monthly spend cap for THIS env in the billing account's default
# currency (PLN for accounts billed in Poland). Alerts fire at
# 50% / 90% / 100% / 120%. Set per developer.
monthly_budget_amount = 50

# Emails that receive budget alerts. Each gets a one-time verification
# email from GCP that must be clicked before delivery actually starts.
notification_emails = [
  # "you@example.com",
]
